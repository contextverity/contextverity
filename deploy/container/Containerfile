# ContextVerity lab image: the demo Backstage backend (catalog, permissions,
# MCP actions, ContextVerity, demo-only lab) plus the bundled frontend.
#
# Build on the host first (Backstage host-build flow), then:
#   make k8s-image        # podman build -f deploy/container/Containerfile .
#
# Base images are pinned by digest (node 22 bookworm-slim, multi-arch index).
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim@sha256:b20fe038d9592822dd534600a1ddf467e985178aa3fed60ec441a056c2cc45bd

FROM ${NODE_IMAGE} AS deps
# Toolchain for native modules (better-sqlite3) if no prebuilt binary matches.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 g++ make \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY .yarn/releases ./.yarn/releases
COPY .yarnrc.yml backstage.json package.json yarn.lock ./
COPY packages/backend/dist/skeleton.tar.gz ./
RUN tar xzf skeleton.tar.gz && rm skeleton.tar.gz \
 && node .yarn/releases/yarn-4.13.0.cjs workspaces focus --all --production \
 && rm -rf .yarn/cache "$(node .yarn/releases/yarn-4.13.0.cjs config get cacheFolder)"

FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps --chown=node:node /app /app
COPY --chown=node:node packages/backend/dist/bundle.tar.gz app-config.yaml ./
RUN tar xzf bundle.tar.gz && rm bundle.tar.gz
COPY --chown=node:node examples/lab ./examples/lab
COPY --chown=node:node packages/backend/src/instrumentation.js ./instrumentation.js
# WORKDIR is created root-owned with mode 0700 by some builders; make it traversable.
RUN chmod 0755 /app
# Non-root (uid 1000, the image's `node` user).
USER 1000:1000
EXPOSE 7007 9464
CMD ["node", "--require", "./instrumentation.js", "packages/backend", "--config", "app-config.yaml", "--config", "/config/app-config.kubernetes.yaml"]
